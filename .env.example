# Copy this file to .env.local and adjust as needed.

# Password for the admin dashboard (/admin). Change this before the event.
ADMIN_PASSWORD=disc-admin-2026

# Secret used to sign the admin session cookie. Use any long random string.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Database -------------------------------------------------------------
# Local development needs nothing here: it uses a SQLite file at ./data/disc.db
# (override the path with DISC_DB_PATH if you like).
# DISC_DB_PATH=./data/disc.db

# For hosted/serverless deploys (e.g. Vercel), point at a Turso database:
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Optional: AI conversational assessment ------------------------------
# Set this to enable the "Chat with our assistant" mode. Without it, the app
# silently shows only the questionnaire.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-opus-4-8).
# DISC_CHAT_MODEL=claude-opus-4-8
